{
  "name": "dsh-fold-delete",
  "version": "1.2.2",
  "description": "折叠较早消息 + 彻底删除会话（DeepSeek Harness 插件）",
  "icon": "icon.png",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/",
    "icon.png",
    "icon.svg",
    "README.md",
    "README.en.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "fold",
    "session",
    "delete",
    "archive"
  ],
  "author": {
    "name": "困困",
    "url": "https://github.com/KunKun24"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KunKun24/dsh-fold-delete.git"
  },
  "homepage": "https://github.com/KunKun24/dsh-fold-delete#readme",
  "bugs": {
    "url": "https://github.com/KunKun24/dsh-fold-delete/issues"
  },
  "engines": {
    "node": ">=22.13.0",
    "dsh": ">=0.2.0-rc.2"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "platform": "web"
    }
  }
}
